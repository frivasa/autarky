#!/bin/bash

# autarky-theme-set: Set a theme, specified by its name.
# Usage: autarky-theme-set <theme-name>

if [[ -z "$1" ]]; then
  echo "Usage: autarky-theme-set <theme-name>" >&2
  exit 1
fi

THEMES_DIR="$HOME/.local/share/autarky/themes/"
CURRENT_THEME_DIR="$HOME/.config/autarky/current/theme"

THEME_NAME="$1"
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR" >&2
  exit 2
fi

# Update theme symlinks
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"

# Change gnome modes
if [[ -f ~/.config/autarky/current/theme/light.mode ]]; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
else
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
fi

# re-link noctalia palette (create if not present)
ln -snf "$HOME/.local/share/autarky/themes/$THEME_NAME/noctalia.json" "$HOME/.config/noctalia/palettes/$THEME_NAME.json"
# Restart components to apply new theme
pkill -SIGUSR2 btop
tmux source ~/.tmux.conf
hyprctl reload
# this kills the shell where this is ran. So keep it at last just in case
hyprctl eval 'hl.exec_cmd("pkill foot; uwsm app -- foot --server")'
