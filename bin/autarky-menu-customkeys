awk '
BEGIN { FS = ":" }

function trim(s) {
    gsub(/^[ \t]+|[ \t]+$/, "", s)
    return s
}

/^#/ || /^[[:space:]]*$/ { next }

{
    if ($0 !~ /<Multi_key>/)
        next

    split($0, parts, ":")
    lhs = parts[1]
    rhs = parts[2]

    emoji = ""
    desc = ""

    if (match(rhs, /"([^"]+)"/, m))
        emoji = m[1]

    if (match(rhs, /#(.*)$/, c))
        desc = trim(c[1])

    gsub(/[<>]/, " ", lhs)
    gsub(/Multi_key/, "M", lhs)

    combo = ""
    n = split(lhs, keys, /[ \t]+/)
    for (j = 1; j <= n; j++) {
        if (keys[j] == "") continue
        combo = combo (combo ? "+" : "") keys[j]
    }

    if (combo != "" && emoji != "") {
        if (desc == "") desc = "-"
        printf "%s %s (%s)\n", emoji, combo, desc
    }
}
' ~/.config/XCompose
