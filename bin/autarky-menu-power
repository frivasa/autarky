#!/bin/bash

show_power_menu() {
  local menu_options=" Lock
󰤄 Suspend
 Relaunch
󰜉 Restart
󰐥 Shutdown"
  local selection
  selection=$(printf '%s\n' "$menu_options" | noctalia dmenu -p "Power Options")
  case "$selection" in
  *Lock*) hyprlock ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) uwsm stop ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  esac
}

show_power_menu
