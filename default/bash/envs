# Editor used by CLI
export EDITOR="nvim"
export VISUAL="nvim"
export SUDO_EDITOR="$EDITOR"

# Ollama
export OLLAMA_HOST=0.0.0.0:8090

# Prompt styling (PS1)
RESET=$'\e[0m'
FG_BLACK=$'\e[30m'
BG_CYAN=$'\e[46m'
BG_GREEN=$'\e[42m'
BG_RED=$'\e[41m'

_directory_prompt() {
  local trimdepth=5
  local symbol='󱀝'
  local root rel path
  local -a parts

  if root=$(git rev-parse --show-toplevel 2>/dev/null); then
    rel=${PWD#"$root"}
    rel=${rel#/}
    IFS=/ read -ra parts <<< "$rel"

    if (( ${#parts[@]} >= trimdepth )); then
      printf -v rel '%s/' "${parts[@]: -$((trimdepth - 1))}"
      path="${root##*/}$symbol/${rel%/}"
    else
      path="${root##*/}/$rel"
    fi
  else
    path=${PWD/#"$HOME"/\~}
  fi

  printf '\001%s\002 %s \001%s\002' "$BG_CYAN$FG_BLACK" "$path" "$RESET"
}

# fastest way to check .git-able + something you should check (we're NOT checking for untracked)
_git_prompt() {
  git rev-parse --is-inside-work-tree &>/dev/null || return

  local branch
  local flags=''

  branch=$(git branch --show-current 2>/dev/null)
  git diff HEAD --quiet 2>/dev/null || flags=' '

  printf '\001%s\002  %s%s \001%s\002' \
    "$BG_GREEN$FG_BLACK" "$branch" "$flags" "$RESET"
}


_pixi_prompt() {
  local label='󰾡󰧲 '

  if [[ -n "$PIXI_ENVIRONMENT_NAME" ]]; then
    label+="$PIXI_ENVIRONMENT_NAME"
  else
    local dir=$PWD
    while [[ ! -f "$dir/pixi.toml" ]]; do
      [[ -z "$dir" ]] && return
      dir=${dir%/*}
    done
  fi

  printf '\001%s\002 %s \001%s\002' \
    "$BG_RED$FG_BLACK" "$label" "$RESET"
}


make_prompt() {
  PS1='$(_pixi_prompt)'
  PS1+='$(_git_prompt)'
  PS1+='$(_directory_prompt)'
  PS1+=' '
}
