# master sourcing, this runs even before hyprland, so everybody will know these

# Autarky functions and setup
export AUTARKY_PATH="$HOME/.local/share/autarky"
export PATH="$HOME/.local/bin:$HOME/.local/share/autarky/bin:./bin:$PATH"
# Rust, Pixi, and Multiviewer binaries
export PATH="$HOME/.cargo/bin:$HOME/.pixi/bin:$HOME/.multiviewer:$PATH"
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx5
export GLFW_IM_MODULE=ibus

# Cursor size
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# now handled by fcitx, this is redundant but computers sure are fucking stupid
export XCOMPOSEFILE=$HOME/.config/XCompose

# Force all apps to use Wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export QT_STYLE_OVERRIDE=kvantum
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland
